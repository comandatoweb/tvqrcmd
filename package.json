{
  "name": "qr-tv-sync",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "cd server && mkdir -p ./.tmp && TS_NODE_DEV_TMPDIR=./.tmp ts-node-dev --cache-directory=./.tmp --respawn --transpile-only src/index.ts",
    "dev:client": "npm --workspace client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run lint && npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "eslint": "^8.25.0",
    "@typescript-eslint/parser": "^5.44.0",
    "@typescript-eslint/eslint-plugin": "^5.44.0",
    "prettier": "^2.8.1",
    "eslint-config-prettier": "^8.8.0",
    "typescript": "~5.1.6"
  }
}
